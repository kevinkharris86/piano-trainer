{
  "name": "Piano Trainer", "short_name": "Piano Trainer", "id": "./", "start_url": "./", "scope": "./",
  "display": "fullscreen", "orientation": "any",
  "background_color": "#0f1117", "theme_color": "#0f1117",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "share_target": {
    "action": "./share", "method": "POST", "enctype": "multipart/form-data",
    "params": { "title": "title", "text": "text", "url": "url",
      "files": [{ "name": "audio", "accept": ["audio/*", "video/*", "audio/midi", "audio/x-midi", ".mid", ".midi", ".mp3", ".m4a", ".webm", ".opus", ".wav"] }] }
  }
}
